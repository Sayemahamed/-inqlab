{
  "name": "inqlab-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:code": "cd packages/code && bun run build",
    "build:intelli": "cd packages/intelli && bun run build",
    "build": "bun run --filter \"*\" build",
    "test:code": "cd packages/code && bun run ./index.ts --help",
    "test:intelli": "cd packages/intelli && bun run ./index.ts --help",
    "test": "bun run test:code && bun run test:intelli"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}